# FrontDir settings for Docker Compose. Copy to .env and edit.
#
# Every setting in docs/ADMIN_GUIDE.md section 7 can be set here, named without
# the FRONTDIR_ prefix (FRONTDIR_TEAM_CREATION -> TEAM_CREATION). Commented-out
# lines show the built-in default. A few settings are fixed by compose.yaml on
# purpose (public URL, database, secrets, proxies, port, data directory, TLS).
#
# Most settings can instead be changed by administrators in the web admin
# area (Admin in the menu). A value set here wins and is locked there, which
# suits settings you manage as code. Leave a line commented to manage it on
# the web.

# Public hostname. Caddy obtains a certificate for it automatically.
FRONTDIR_HOST=files.example.com

# ---- Sign-in: OIDC, SAML, or both; here or on the web -------------------------
# Either leave this section commented out and, after `docker compose up -d`,
# run `docker compose exec frontdir /frontdir setup-link`: it prints a one-time
# link to a page where you configure sign-in and become the first administrator.
# Or configure a method here (each method entirely here or entirely on the web).
#
# OpenID Connect (Keycloak, Authentik, Zitadel, Pocket ID, Entra ID, ...).
# Register a confidential client with redirect URI https://<FRONTDIR_HOST>/auth/callback
# and put its client secret in secrets/oidc_client_secret.
#OIDC_ISSUER=https://id.example.com/realms/home
#OIDC_CLIENT_ID=frontdir
# Claim holding group names, and the scopes to request.
#OIDC_GROUPS_CLAIM=groups
#OIDC_SCOPES=openid,email,profile

# SAML 2.0. Register FrontDir at your IdP from https://<FRONTDIR_HOST>/auth/saml/metadata
# (ACS: https://<FRONTDIR_HOST>/auth/saml/acs, NameID format: persistent).
# Give the IdP's metadata as an https URL, or as a file in ./saml (one or the other).
#SAML_IDP_METADATA_URL=
#SAML_IDP_METADATA_FILE=/etc/frontdir/saml/idp-metadata.xml
# SP entity ID; the default is https://<FRONTDIR_HOST>/auth/saml/metadata.
#SAML_ENTITY_ID=
# Optional SP key pair in ./saml (signs requests, decrypts encrypted assertions).
#SAML_SP_KEY_FILE=/etc/frontdir/saml/sp.key
#SAML_SP_CERT_FILE=/etc/frontdir/saml/sp.crt
# SAML has no "email verified" flag. Set true only if your IdP verifies emails
# (needed for sharing by email and for ALLOWED_EMAIL_DOMAINS).
#SAML_TRUST_EMAIL=false
# Attribute names to read, comma-separated, if your IdP uses unusual ones.
#SAML_EMAIL_ATTRIBUTES=
#SAML_NAME_ATTRIBUTES=
#SAML_GROUP_ATTRIBUTES=

# Local accounts: email, password and a one-time code from an authenticator
# app (both always required). Administrators create them under Admin > People.
#LOCAL_ACCOUNTS=false
#LOCAL_ADMINS=false

# ---- Who may sign in, and who administers -----------------------------------
# Strongly recommended: restrict sign-in (comma-separated), here or on the web.
#ALLOWED_GROUPS=frontdir-users
#ALLOWED_EMAIL_DOMAINS=
# Members of these IdP groups are administrators (as are people appointed in
# the admin area, and whoever completes the setup link).
#ADMIN_GROUPS=frontdir-admins
# Whether every user may create team folders (false: administrators only).
#TEAM_CREATION=true

# ---- Storage and limits -----------------------------------------------------
#DEFAULT_QUOTA=10GiB
#DEFAULT_TEAM_QUOTA=50GiB
#MAX_FILE_SIZE=50GiB
#MAX_VERSIONS=10
#TRASH_RETENTION=30d

# ---- Sharing and sessions ---------------------------------------------------
#LINK_DEFAULT_TTL=30d
#LINK_MAX_TTL=365d
#SESSION_IDLE=12h
#SESSION_MAX_AGE=7d

# ---- Runtime ----------------------------------------------------------------
#LOG_LEVEL=info
#WEBDAV=true
#WORKER=true
#AUTO_MIGRATE=true
# false makes every setting read-only in the web admin area (configuration
# as code only). The setup link still works for appointing an administrator.
#WEB_SETTINGS=true

# ---- Branding (optional, docs/THEMING.md) -----------------------------------
# Files go in ./branding (mounted read-only at /etc/frontdir/branding).
# An invalid theme stops startup with a list of problems. Or set these in the
# admin area (Branding), where they are checked the same way before saving.
#BRAND_NAME=
#THEME_FILE=/etc/frontdir/branding/theme.json
#BRAND_LOGO_FILE=/etc/frontdir/branding/logo.png
