# NoddaNAS settings for Docker Compose. Copy to .env and edit.
#
# Every setting in docs/ADMIN_GUIDE.md section 7 can be set here, named without
# the NODDANAS_ prefix (NODDANAS_TEAM_CREATION -> TEAM_CREATION). Commented-out
# lines show the built-in default. A few settings are fixed by compose.yaml on
# purpose (public URL, database, secrets, proxies, port, data directory, TLS).

# Public hostname. Caddy obtains a certificate for it automatically.
NODDANAS_HOST=files.example.com

# ---- Sign-in: configure OIDC, SAML, or both ----------------------------------
# OpenID Connect (Keycloak, Authentik, Zitadel, Pocket ID, Entra ID, ...).
# Register a confidential client with redirect URI https://<NODDANAS_HOST>/auth/callback
# and put its client secret in secrets/oidc_client_secret.
OIDC_ISSUER=https://id.example.com/realms/home
OIDC_CLIENT_ID=noddanas
# Claim holding group names, and the scopes to request.
#OIDC_GROUPS_CLAIM=groups
#OIDC_SCOPES=openid,email,profile

# SAML 2.0. Register NoddaNAS at your IdP from https://<NODDANAS_HOST>/auth/saml/metadata
# (ACS: https://<NODDANAS_HOST>/auth/saml/acs, NameID format: persistent).
# Give the IdP's metadata as an https URL, or as a file in ./saml (one or the other).
SAML_IDP_METADATA_URL=
#SAML_IDP_METADATA_FILE=/etc/noddanas/saml/idp-metadata.xml
# SP entity ID; the default is https://<NODDANAS_HOST>/auth/saml/metadata.
#SAML_ENTITY_ID=
# Optional SP key pair in ./saml (signs requests, decrypts encrypted assertions).
#SAML_SP_KEY_FILE=/etc/noddanas/saml/sp.key
#SAML_SP_CERT_FILE=/etc/noddanas/saml/sp.crt
# SAML has no "email verified" flag. Set true only if your IdP verifies emails
# (needed for sharing by email and for ALLOWED_EMAIL_DOMAINS).
SAML_TRUST_EMAIL=false
# Attribute names to read, comma-separated, if your IdP uses unusual ones.
#SAML_EMAIL_ATTRIBUTES=
#SAML_NAME_ATTRIBUTES=
#SAML_GROUP_ATTRIBUTES=

# ---- Who may sign in, and who administers -----------------------------------
# Strongly recommended: restrict sign-in (comma-separated).
ALLOWED_GROUPS=noddanas-users
ALLOWED_EMAIL_DOMAINS=
# Members of these IdP groups can map groups to team folders and set quotas.
ADMIN_GROUPS=noddanas-admins
# Whether every user may create team folders (false: administrators only).
#TEAM_CREATION=true

# ---- Storage and limits -----------------------------------------------------
DEFAULT_QUOTA=10GiB
DEFAULT_TEAM_QUOTA=50GiB
#MAX_FILE_SIZE=50GiB
#MAX_VERSIONS=10
#TRASH_RETENTION=30d

# ---- Sharing and sessions ---------------------------------------------------
#LINK_DEFAULT_TTL=30d
#LINK_MAX_TTL=365d
#SESSION_IDLE=12h
#SESSION_MAX_AGE=7d

# ---- Runtime ----------------------------------------------------------------
#LOG_LEVEL=info
#WEBDAV=true
#WORKER=true
#AUTO_MIGRATE=true

# ---- Branding (optional, docs/THEMING.md) -----------------------------------
# Files go in ./branding (mounted read-only at /etc/noddanas/branding).
# An invalid theme stops startup with a list of problems.
BRAND_NAME=
#THEME_FILE=/etc/noddanas/branding/theme.json
#BRAND_LOGO_FILE=/etc/noddanas/branding/logo.png
