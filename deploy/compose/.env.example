# Public hostname. Caddy obtains a certificate for it automatically.
NODDANAS_HOST=files.example.com

# Your OpenID Connect provider (Keycloak, Authentik, Zitadel, Pocket ID, ...).
# Register a confidential client with redirect URI:
#   https://<NODDANAS_HOST>/auth/callback
# and put its client secret in secrets/oidc_client_secret.
OIDC_ISSUER=https://id.example.com/realms/home
OIDC_CLIENT_ID=noddanas

# Strongly recommended: restrict who may sign in (comma-separated).
OIDC_ALLOWED_GROUPS=noddanas-users
OIDC_ALLOWED_EMAIL_DOMAINS=

DEFAULT_QUOTA=10GiB
